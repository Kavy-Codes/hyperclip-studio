# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Binary files - prevent git from corrupting them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar.gz binary
